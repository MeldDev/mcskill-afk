[Unit]
Description=MCSkill protocol 5 headless AFK client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mcskill-afk
Group=mcskill-afk
WorkingDirectory=/opt/mcskill-afk
Environment=MC_CREDENTIALS_FILE=/etc/mcskill-afk/credentials.json
Environment=NODE_ENV=production
Environment=MC_CONTROL_SOCKET=/run/mcskill-afk/control.sock
EnvironmentFile=-/etc/mcskill-afk/config
ExecStart=/opt/mcskill-afk/runtime/node --max-old-space-size=192 /opt/mcskill-afk/tools/login-and-afk.js --service
# Network failures retry inside the app. Restart crashes; terminal auth/policy errors require attention.
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=78
KillSignal=SIGTERM
TimeoutStopSec=15
MemoryHigh=256M
MemoryMax=300M
CPUQuota=90%
TasksMax=32
LimitNOFILE=128
UMask=0077
RuntimeDirectory=mcskill-afk
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
