# Environment variables must be exported by your shell; no dotenv loader.
MC_HOST=titan.skydrive.metalabs.work
MC_PORT=25565
MC_SESSION_FILE=/etc/mcskill-afk/session.json
# Password launcher/service mode; file contains secrets, never commit it.
# Default for interactive launch: ~/.config/mcskill-afk/credentials.json
# MC_CREDENTIALS_FILE=/etc/mcskill-afk/credentials.json
MCSKILL_AUTH_ORIGIN=https://auth.mcskill.ru
MCSKILL_AUTH_MODE=modern
FORGE_PROFILE=mcskill
MC_RECONNECT_MODE=fixed
MC_RECONNECT_INTERVAL_MS=60000
# -1: unlimited retries; 0: no retries.
MC_MAX_RETRIES=-1
MC_RECONNECT_BASE_MS=15000
MC_RECONNECT_MAX_MS=300000
MC_TIMEOUT_MS=30000
MC_IDLE_TIMEOUT_MS=90000
MC_TEST_DURATION_MS=30000
# Incoming server chat in console/journal (1 enabled, 0 disabled).
MC_CHAT=1
# Optional local control endpoint, enabled by the systemd unit.
# MC_CONTROL_SOCKET=/run/mcskill-afk/control.sock
# Alternatively MC_USERNAME, MC_UUID, MC_ACCESS_TOKEN (avoid shell history).
